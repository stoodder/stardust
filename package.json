{
  "name": "stardust",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.pure.json --noEmit && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "oxlint --type-aware && prettier --check --cache --cache-strategy content .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "node --experimental-strip-types tools/sim.ts",
    "smoke": "playwright test --trace off",
    "check:docs": "node --experimental-strip-types tools/check-docs.ts",
    "check": "node --experimental-strip-types tools/gate.ts",
    "check:fast": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "@preact/signals": "2.11.4",
    "phaser": "4.2.1",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
