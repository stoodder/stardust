{
  // Node-side code: tools, smoke specs, build configs, and the architecture test (reads files).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    // vite/client: app modules the smoke specs import read `import.meta.env` (undefined in Node).
    "types": ["node", "vite/client"]
  },
  "include": [
    "tools",
    "smoke",
    "vite.config.ts",
    "playwright.config.ts",
    "src/shared/architecture.test.ts"
  ]
}
